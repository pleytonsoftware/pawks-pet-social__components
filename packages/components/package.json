{
	"name": "@pawks/components",
	"version": "0.1.0",
	"private": false,
	"publishConfig": {
		"access": "public",
		"registry": "https://REPLACE_WITH_VERDACCIO_URL/"
	},
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./styles.css": "./dist/styles.css",
		"./theme.css": "./dist/theme.css",
		"./*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js",
			"require": "./dist/*.cjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm run build:js && pnpm run build:css",
		"build:js": "node scripts/generate-index.mjs && tsup && tsc --emitDeclarationOnly && node scripts/flatten-dts.mjs",
		"build:css": "pnpm run build:css:styles && pnpm run build:css:theme",
		"build:css:styles": "tailwindcss -i ./src/styles/tailwind.css -o ./dist/styles.css --minify",
		"build:css:theme": "cp ./src/styles/theme.css ./dist/theme.css",
		"dev": "node scripts/generate-index.mjs && tsup --watch",
		"lint": "node scripts/generate-index.mjs && eslint . --max-warnings 0",
		"check-types": "node scripts/generate-index.mjs && tsc --noEmit"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"dependencies": {
		"@radix-ui/react-slot": "1.3.3",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@config/eslint-config": "workspace:*",
		"@config/typescript-config": "workspace:*",
		"@tailwindcss/cli": "4.3.3",
		"@types/node": "26.4.1",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "10.9.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwindcss": "4.3.3",
		"tsup": "8.5.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
