{
	"extends": "@config/typescript-config/react-library.json",
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"]
		},
		"target": "es2023",
		"lib": ["es2023", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"types": ["vite/client", "node"],
		"skipLibCheck": true
	},
	"include": ["src", "stories", ".storybook", "vite.config.ts"]
}
